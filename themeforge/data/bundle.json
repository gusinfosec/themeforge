    {
      "id": "catppuccin-mocha",
      "name": "Catppuccin Mocha",
      "description": "A cozy dark theme with soft pastel accents — a favourite on every distro.",
      "gtk_theme": "catppuccin-mocha",
      "shell_theme": "catppuccin-mocha",
      "icon_theme": "papirus",
      "color_scheme": "prefer-dark",
      "wallpaper": "wallpaper-catppuccin-mocha"
    },
    {
      "id": "catppuccin-latte",
      "name": "Catppuccin Latte",
